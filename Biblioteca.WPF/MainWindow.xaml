<Window x:Class="Biblioteca.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vistas="clr-namespace:Biblioteca.WPF.Vistas"
        Language="es-PE"
        Title="Biblioteca"
        Height="620"
        Width="960"
        MinHeight="520"
        MinWidth="800"
        WindowStartupLocation="CenterScreen">
    <TabControl Margin="8">
        <TabItem Header="Libros">
            <vistas:UcLibros/>
        </TabItem>
        <TabItem Header="Socios">
            <vistas:UcSocios/>
        </TabItem>
        <TabItem Header="Préstamo">
            <vistas:UcPrestamo/>
        </TabItem>
        <TabItem Header="Devolución">
            <vistas:UcDevolucion/>
        </TabItem>
        <TabItem Header="Reporte">
            <vistas:UcReporte/>
        </TabItem>
    </TabControl>
</Window>
