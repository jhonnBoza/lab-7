<UserControl x:Class="Biblioteca.WPF.Vistas.UcDevolucion"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Uc_Loaded">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Registrar devolución" FontSize="16" FontWeight="Bold"/>
        <TextBlock x:Name="txtAyuda" Grid.Row="1" Margin="6,0,0,8" TextWrapping="Wrap"/>

        <DataGrid x:Name="dgPendientes" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False"
                  SelectionChanged="DgPendientes_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Préstamo" Binding="{Binding PrestamoId}" Width="80"/>
                <DataGridTextColumn Header="Socio" Binding="{Binding Socio}" Width="*"/>
                <DataGridTextColumn Header="Libro" Binding="{Binding Libro}" Width="2*"/>
                <DataGridTextColumn Header="Fecha límite" Binding="{Binding FechaLimite, StringFormat=dd/MM/yyyy}" Width="110"/>
                <DataGridTextColumn Header="Días de retraso" Binding="{Binding DiasRetraso}" Width="110"/>
                <DataGridTextColumn Header="Multa" Binding="{Binding Multa, StringFormat={}S/ {0:N2}}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <Button x:Name="btnDevolver" Content="Registrar devolución" Width="160" Click="BtnDevolver_Click"/>
            <TextBlock x:Name="txtDetalle" Margin="12,4,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="txtMulta" Margin="12,4,0,0" VerticalAlignment="Center" FontWeight="Bold"/>
        </StackPanel>

        <TextBlock x:Name="txtEstado" Grid.Row="4" Margin="4,6,0,0"/>
    </Grid>
</UserControl>
