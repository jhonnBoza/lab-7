<UserControl x:Class="Biblioteca.WPF.Vistas.UcSocios"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="Uc_Loaded">
    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Label Content="Mantenimiento de socios" FontSize="16" FontWeight="Bold"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,4,0,8">
            <Label Content="Buscar:" VerticalAlignment="Center"/>
            <TextBox x:Name="txtBuscar" Width="280" Height="24" VerticalAlignment="Center" KeyDown="TxtBuscar_KeyDown"/>
            <Button Content="Buscar" Width="80" Margin="8,0,0,0" Click="BtnBuscar_Click"/>
            <Button Content="Ver todos" Width="90" Margin="8,0,0,0" Click="BtnTodos_Click"/>
        </StackPanel>

        <DataGrid x:Name="dgSocios" Grid.Row="2"
                  AutoGenerateColumns="False" IsReadOnly="True"
                  SelectionMode="Single" CanUserAddRows="False"
                  SelectionChanged="DgSocios_SelectionChanged">
            <DataGrid.Columns>
                <DataGridTextColumn Header="DNI" Binding="{Binding DNI}" Width="120"/>
                <DataGridTextColumn Header="Nombre" Binding="{Binding Nombre}" Width="*"/>
                <DataGridTextColumn Header="Correo" Binding="{Binding Email}" Width="260"/>
            </DataGrid.Columns>
        </DataGrid>

        <GroupBox Grid.Row="3" Header="Datos del socio" Margin="0,8,0,0">
            <Grid Margin="6">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Label Content="DNI:"/>
                <TextBox x:Name="txtDni" Grid.Column="1" Height="24" Margin="0,4" VerticalAlignment="Center" MaxLength="8"/>
                <Label Grid.Column="2" Content="Nombre:"/>
                <TextBox x:Name="txtNombre" Grid.Column="3" Height="24" Margin="0,4" VerticalAlignment="Center" MaxLength="120"/>
                <Label Grid.Column="4" Content="Correo:"/>
                <TextBox x:Name="txtEmail" Grid.Column="5" Height="24" Margin="0,4" VerticalAlignment="Center" MaxLength="120"/>

                <StackPanel Grid.Row="1" Grid.ColumnSpan="6" Orientation="Horizontal" Margin="0,6,0,0">
                    <Button x:Name="btnNuevo" Content="Nuevo" Width="90" Margin="0,0,8,0" Click="BtnNuevo_Click"/>
                    <Button x:Name="btnGuardar" Content="Guardar" Width="90" Margin="0,0,8,0" Click="BtnGuardar_Click"/>
                    <Button x:Name="btnEliminar" Content="Dar de baja" Width="100" Click="BtnEliminar_Click"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <TextBlock x:Name="txtEstado" Grid.Row="4" Margin="4,6,0,0"/>
    </Grid>
</UserControl>
